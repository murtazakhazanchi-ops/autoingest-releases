{
  "name": "auto-ingest",
  "version": "0.9.14",
  "description": "AutoIngest — AJS Photo Archive Ingest System",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "validate:metadata": "node scripts/validate-event-metadata.js",
    "realtime:install": "cd realtime-server && npm install",
    "realtime:start": "cd realtime-server && node server.js"
  },
  "dependencies": {
    "argparse": "^2.0.1",
    "bindings": "^1.5.0",
    "builder-util-runtime": "^9.5.1",
    "debug": "^3.2.7",
    "drivelist": "^9.2.4",
    "file-uri-to-path": "^1.0.0",
    "fs-extra": "^8.1.0",
    "graceful-fs": "^4.2.11",
    "js-yaml": "^4.1.1",
    "jsonfile": "^4.0.0",
    "lazy-val": "^1.0.5",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.isequal": "^4.5.0",
    "ms": "^2.1.3",
    "sax": "^1.6.0",
    "semver": "^6.3.1",
    "tiny-typed-emitter": "^2.1.0",
    "universalify": "^0.1.2",
    "electron-updater": "^6.3.9",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^28.8.0",
    "googleapis": "^144.0.0",
    "lucide": "^1.11.0",
    "pdfjs-dist": "5.4.624",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.7.5",
    "ws": "^8.20.1"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@napi-rs/canvas-darwin-arm64": "0.1.100"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.autoingest.app",
    "productName": "AutoIngest",
    "publish": [
      {
        "provider": "github",
        "owner": "murtazakhazanchi-ops",
        "repo": "autoingest-releases",
        "private": false,
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "config/service-account-key.json",
        "to": "config/service-account-key.json"
      }
    ],
    "files": [
      "main/**/*",
      "renderer/**/*",
      "services/**/*",
      "config/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/bindings/**/*",
      "node_modules/@img/sharp-darwin-arm64/**/*",
      "node_modules/@img/sharp-libvips-darwin-arm64/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/@napi-rs/canvas-darwin-arm64/**/*",
      "!**/node_modules/.cache/**",
      "!dist/**",
      "!**/*.md",
      "!**/.git/**"
    ],
    "asarUnpack": [
      "main/exiftool-config.pl",
      "node_modules/exiftool-vendored.pl/**/*",
      "node_modules/exiftool-vendored.exe/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/@img/sharp-darwin-arm64/**/*",
      "node_modules/@img/sharp-libvips-darwin-arm64/**/*",
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/@napi-rs/canvas-darwin-arm64/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/mac.icns",
      "category": "public.app-category.photography",
      "hardenedRuntime": true
    },
    "dmg": {
      "sign": true,
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/win.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/win.ico",
      "uninstallerIcon": "assets/win.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
