#!/bin/sh
# Part 5/7 documentation-automation pre-commit gate.
# Version-controlled — installed by `node scripts/product-docs/cli.js automation install-hooks`.
# Never edit .git/hooks/pre-commit directly; edit this file instead.
#
# What it checks (fast — target under 2s; see automation/hookAutomation.js's
# preCommitGate for the actual logic, kept in JS so it's unit-testable):
#   1. If staged files include docs/product/ content, require
#      docs/product/generated/ to already be fresh (validate must pass) — a
#      stale index is treated the same as a stale registry row.
#   2. Discovers any pending Evidence Packet whose affected_files overlap
#      the staged files; in STRICT mode, blocks until it's finalized.
# Never auto-finalizes here (a commit is often mid-task) — see pre-push.
# Bypass (emergency only, audited): AUTOINGEST_DOCS_BYPASS=1 git commit ...

set -e

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0
[ -z "$REPO_ROOT" ] && exit 0

if [ "$AUTOINGEST_DOCS_BYPASS" = "1" ]; then
  echo "[autoingest-docs] pre-commit BYPASSED via AUTOINGEST_DOCS_BYPASS=1 (audited in .autoingest-docs/audit/)"
  exit 0
fi

cd "$REPO_ROOT"
STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

# Fast no-op path: skip spawning node entirely unless this commit could
# plausibly need the gate — docs/product/ is staged, or a pending Evidence
# Packet exists at all (STRICT-mode overlap can only matter if one does).
# Keeps the true no-op case comfortably under the 500ms target.
NEEDS_GATE=0
if echo "$STAGED" | grep -q '^docs/product/'; then
  NEEDS_GATE=1
fi
PENDING_DIR="$REPO_ROOT/.autoingest-docs/sessions/pending"
if [ -d "$PENDING_DIR" ] && [ -n "$(ls -A "$PENDING_DIR" 2>/dev/null)" ]; then
  NEEDS_GATE=1
fi
[ "$NEEDS_GATE" = "1" ] || exit 0

node "$REPO_ROOT/scripts/product-docs/cli.js" automation pre-commit-gate || {
  echo "[autoingest-docs] pre-commit BLOCKED — see findings above."
  echo "[autoingest-docs] Emergency bypass: AUTOINGEST_DOCS_BYPASS=1 git commit ..."
  exit 1
}
exit 0
