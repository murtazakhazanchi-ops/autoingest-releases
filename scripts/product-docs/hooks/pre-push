#!/bin/sh
# Part 5/7 documentation-automation pre-push gate.
# Version-controlled — installed by `node scripts/product-docs/cli.js automation install-hooks`.
# Never edit .git/hooks/pre-push directly; edit this file instead.
#
# Auto-finalizes any pending session whose evidence gate would already pass
# cleanly, runs full documentation health validation, and reports a push
# impact summary (automation/hookAutomation.js's prePushGate). Target:
# under 10s (build+validate on this repository's current scale is well
# under 1s — see scripts/product-docs/README.md; the budget covers slower
# CI-adjacent machines and future growth).
# Bypass (emergency only, audited): AUTOINGEST_DOCS_BYPASS=1 git push ...
# Never auto-pushes anything itself — this hook only ever blocks or allows
# the push the user already initiated.

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -z "$REPO_ROOT" ] && exit 0

if [ "$AUTOINGEST_DOCS_BYPASS" = "1" ]; then
  echo "[autoingest-docs] pre-push BYPASSED via AUTOINGEST_DOCS_BYPASS=1 (audited in .autoingest-docs/audit/)"
  exit 0
fi

cd "$REPO_ROOT"

node "$REPO_ROOT/scripts/product-docs/cli.js" automation pre-push-gate || {
  echo "[autoingest-docs] PUSH BLOCKED — see findings above."
  echo "[autoingest-docs] Run 'node scripts/product-docs/cli.js build && node scripts/product-docs/cli.js validate' or 'automation finalize' as directed, then retry."
  echo "[autoingest-docs] Emergency bypass: AUTOINGEST_DOCS_BYPASS=1 git push ..."
  exit 1
}

echo "[autoingest-docs] pre-push validation passed."
exit 0
